{
  "name": "dsh-plugin-composer-focus",
  "version": "0.1.0",
  "private": true,
  "description": "Focus the chat composer from anywhere in the window with a keyboard shortcut.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test"
  },
  "exports": {
    ".": "./src/index.js",
    "./client": "./src/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "cordis.patch.yml",
    "locale",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.0 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-shortcuts",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
